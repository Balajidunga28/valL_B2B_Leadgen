# ValLG Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to version control.

# Application
APP_NAME=ValLG
APP_VERSION=0.1.0
DEBUG=false

# Database (Neon PostgreSQL for production)
# Format: postgresql://user:password@host/dbname?sslmode=require
# Neon: https://console.neon.tech
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/vallg?sslmode=require
DATABASE_URL_ASYNC=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/vallg?sslmode=require

# Auth
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE-ME-TO-A-RANDOM-SECRET-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Google Places API (optional)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# CORS (comma-separated origins)
# Production: https://your-app.pages.dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
